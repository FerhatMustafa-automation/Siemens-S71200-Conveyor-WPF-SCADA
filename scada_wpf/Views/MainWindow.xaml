<Window x:Class="DigitalTwinScada.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DigitalTwinScada.ViewModels"
        mc:Ignorable="d"
        Title="Digital Twin SCADA - Siemens S7-1200 &amp; Factory I/O [Ferhat Mustafa Çalışır]" 
        Height="780" Width="1240"
        MinHeight="680" MinWidth="1080"
        Background="#0F172A" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Renk Paletleri -->
        <SolidColorBrush x:Key="BgDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="CardBg" Color="#1E293B"/>
        <SolidColorBrush x:Key="CardBorder" Color="#334155"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#0EA5E9"/>
        <SolidColorBrush x:Key="StatusGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="StatusAmber" Color="#F59E0B"/>
        <SolidColorBrush x:Key="StatusRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="TextLight" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>

        <!-- Boolean to Visibility & Color Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Kart Stili -->
        <Style x:Key="IndustrialCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <!-- Buton Temel Stili -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Alarm Banner -->
            <RowDefinition Height="*"/>    <!-- Main Body -->
            <RowDefinition Height="180"/>  <!-- Bottom Log & Telemetry -->
        </Grid.RowDefinitions>

        <!-- =================================================================== -->
        <!-- 1. HEADER KATMANI (Başlık, PLC IP, Bağlantı Durumu) -->
        <!-- =================================================================== -->
        <Border Grid.Row="0" Style="{StaticResource IndustrialCard}" Margin="0,0,0,12" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Başlık ve Rozet -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0284C7" Width="36" Height="36" CornerRadius="8" Margin="0,0,12,0">
                        <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="DIGITAL TWIN CONVEYOR SCADA" Foreground="{StaticResource TextLight}" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Siemens S7-1200 (PLC) ⟷ Factory I/O (3D Twin) ⟷ C# .NET 8 (MVVM)" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Bağlantı Kontrolleri -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Durum Göstergesi -->
                    <Border Background="#0F172A" CornerRadius="20" Padding="10,4" Margin="0,0,14,0" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource StatusRed}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource StatusGreen}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionStatusText}" Foreground="{StaticResource TextLight}" FontSize="12" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>

                    <!-- IP Girişi -->
                    <TextBlock Text="PLC IP:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                    <TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" 
                             Width="110" Height="32" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                             Background="#0F172A" Foreground="White" BorderBrush="{StaticResource CardBorder}" Margin="0,0,10,0"/>

                    <!-- Bağlan / Kes Butonları -->
                    <Button Content="Bağlan" Command="{Binding ConnectCommand}" Style="{StaticResource ModernButton}" Background="#0284C7" Width="80" Height="32" Margin="0,0,6,0"/>
                    <Button Content="Bağlantıyı Kes" Command="{Binding DisconnectCommand}" Style="{StaticResource ModernButton}" Background="#DC2626" Width="100" Height="32"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- =================================================================== -->
        <!-- 2. ALARM VE GÜVENLİK BİLDİRİM BANNER'I (Sadece Hata Varken Görünür) -->
        <!-- =================================================================== -->
        <Border Grid.Row="1" Margin="0,0,0,12" CornerRadius="6" Padding="14,10" Background="#7F1D1D" BorderBrush="#EF4444" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusAlarm}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚠️ AKTİF ALARM:" Foreground="#FCA5A5" FontWeight="Bold" FontSize="14" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding AlarmDescription}" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text=" (Kod: " Foreground="#FCA5A5" FontSize="14"/>
                    <TextBlock Text="{Binding AlarmCode}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text=")" Foreground="#FCA5A5" FontSize="14"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Alarmı Sıfırla (Reset)" Command="{Binding ResetAlarmCommand}" 
                        Style="{StaticResource ModernButton}" Background="#B91C1C" Padding="16,0" Height="30"/>
            </Grid>
        </Border>

        <!-- =================================================================== -->
        <!-- 3. ANA GÖVDE (Metrikler, 3D Süreç Mimik Paneli, Operatör Kontrolleri) -->
        <!-- =================================================================== -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/> <!-- Sol Panel: Telemetri & Sayaçlar -->
                <ColumnDefinition Width="*"/>   <!-- Orta Panel: Süreç ve Sensör Mimik -->
                <ColumnDefinition Width="280"/> <!-- Sağ Panel: Kontrol & E-Stop -->
            </Grid.ColumnDefinitions>

            <!-- SOL PANEL: ÜRETİM VE TELEMETRİ METRİKLERİ -->
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <!-- Üretim Sayaçları Kartı -->
                <Border Style="{StaticResource IndustrialCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ÜRETİM SAYICILARI" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Toplam Sağlam Parça -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Sağlam Ürün" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                <TextBlock Text="{Binding PieceCountTotal}" Foreground="{StaticResource StatusGreen}" FontSize="28" FontWeight="Bold"/>
                            </StackPanel>
                            <!-- Hatalı / Ayrılan Parça -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Ayrılan (Defect)" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                <TextBlock Text="{Binding PieceCountRejected}" Foreground="{StaticResource StatusAmber}" FontSize="28" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                        <Button Content="Sayıcıları Sıfırla" Command="{Binding ClearCountCommand}" Style="{StaticResource ModernButton}" Background="#334155" Height="28" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Motor Hız Kontrol & Geri Besleme Kartı -->
                <Border Style="{StaticResource IndustrialCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="KONVEYÖR HIZ DENETİMİ" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Anlık Hız (Geri Besleme):" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding ActualSpeedRpm}" Foreground="{StaticResource AccentCyan}" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text=" RPM" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                            </StackPanel>
                        </Grid>
                        <!-- Hedef Hız Ayarı -->
                        <TextBlock Text="Hedef Hız Set Değeri:" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,4,0,4"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Value="{Binding SetSpeedRpm, Mode=TwoWay}" Minimum="0" Maximum="1500" SmallChange="50" LargeChange="200" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding SetSpeedRpm}" Foreground="White" FontWeight="Bold" Width="42" TextAlignment="Right"/>
                        </Grid>
                        <Button Content="Hız Değerini Gönder (DBW2)" Command="{Binding ApplySpeedCommand}" Style="{StaticResource ModernButton}" Background="#0284C7" Height="30" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Termal & Akım Telemetrisi -->
                <Border Style="{StaticResource IndustrialCard}">
                    <StackPanel>
                        <TextBlock Text="MOTOR SAĞLIK TELEMETRİSİ" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Motor Akımı:" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding MotorCurrentAmp}" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text=" A" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Bottom"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <TextBlock Text="Motor Sıcaklığı:" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding MotorTemperature}" Foreground="{StaticResource StatusAmber}" FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text=" °C" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Bottom"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ORTA PANEL: SÜREÇ & DİJİTAL İKİZ SENSÖR MİMİK ŞEMASI -->
            <Border Grid.Column="1" Style="{StaticResource IndustrialCard}" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="3D DİJİTAL İKİZ HAT DURUMU (MIMIC DIAGRAM)" Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="Bold"/>

                    <!-- Süreç Görseli ve Sensör Durumları -->
                    <Border Grid.Row="1" Background="#0B132B" CornerRadius="8" Margin="0,12,0,12" BorderBrush="#1C2541" BorderThickness="1">
                        <Grid Margin="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Sinyal Kulesi ve Hat Durumu -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Sinyal Kulesi: " Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                                <!-- Yeşil -->
                                <Ellipse Width="14" Height="14" Margin="4,0" Stroke="#10B981" StrokeThickness="1">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#064E3B"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusRunning}" Value="True">
                                                    <Setter Property="Fill" Value="#10B981"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <!-- Sarı -->
                                <Ellipse Width="14" Height="14" Margin="4,0" Stroke="#F59E0B" StrokeThickness="1">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#78350F"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusStopped}" Value="True">
                                                    <Setter Property="Fill" Value="#F59E0B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <!-- Kırmızı -->
                                <Ellipse Width="14" Height="14" Margin="4,0" Stroke="#EF4444" StrokeThickness="1">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#7F1D1D"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusAlarm}" Value="True">
                                                    <Setter Property="Fill" Value="#EF4444"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </StackPanel>

                            <!-- Konveyör ve Eyleyici Şeması -->
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <!-- Giriş Konveyörü Çizimi -->
                                <Border Background="#1E293B" CornerRadius="6" Width="440" Height="50" BorderBrush="{StaticResource AccentCyan}" BorderThickness="2">
                                    <Grid>
                                        <TextBlock Text="Giriş Konveyörü (%Q0.0)" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold"/>
                                        <!-- Giriş Fotoseli Göstergesi -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Center">
                                            <Ellipse Width="12" Height="12" Stroke="#38BDF8" StrokeThickness="1">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#1E293B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusSensorEntry}" Value="True">
                                                                <Setter Property="Fill" Value="#38BDF8"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text=" Giriş Sensörü (%I0.4)" Foreground="{StaticResource TextMuted}" FontSize="10" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Ayırıcı Piston Bölgesi -->
                                <Border Background="#334155" CornerRadius="4" Width="160" Height="36" Margin="0,8" HorizontalAlignment="Center">
                                    <Grid>
                                        <TextBlock Text="Pnömatik İtici (%Q0.2)" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                    </Grid>
                                </Border>

                                <!-- Çıkış Konveyörü Çizimi -->
                                <Border Background="#1E293B" CornerRadius="6" Width="440" Height="50" BorderBrush="{StaticResource AccentCyan}" BorderThickness="2">
                                    <Grid>
                                        <TextBlock Text="Çıkış Konveyörü (%Q0.1)" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold"/>
                                        <!-- Çıkış Fotoseli Göstergesi -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,20,0" VerticalAlignment="Center">
                                            <Ellipse Width="12" Height="12" Stroke="#10B981" StrokeThickness="1">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#1E293B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusSensorExit}" Value="True">
                                                                <Setter Property="Fill" Value="#10B981"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text=" Çıkış Sayıcı (%I0.5)" Foreground="{StaticResource TextMuted}" FontSize="10" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Sensör Durum Çubuğu -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Giriş Sensörü: %I0.4" Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="İtici Limit: %I0.7" Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="Çıkış Sensörü: %I0.5" Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- SAĞ PANEL: OPERATÖR VE ACİL STOP KONTROLLERİ -->
            <Border Grid.Column="2" Style="{StaticResource IndustrialCard}">
                <StackPanel>
                    <TextBlock Text="OPERATÖR KONTROL PANELİ" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,14"/>

                    <!-- Başlat Butonu -->
                    <Button Content="SİSTEMİ BAŞLAT (START)" Command="{Binding StartCommand}" Style="{StaticResource ModernButton}" 
                            Background="#059669" Height="48" FontSize="14" Margin="0,0,0,10"/>

                    <!-- Durdur Butonu -->
                    <Button Content="SİSTEMİ DURDUR (STOP)" Command="{Binding StopCommand}" Style="{StaticResource ModernButton}" 
                            Background="#475569" Height="42" FontSize="13" Margin="0,0,0,14"/>

                    <Separator Background="{StaticResource CardBorder}" Margin="0,0,0,14"/>

                    <!-- Çalışma Modu (Otomatik / Manuel) -->
                    <TextBlock Text="ÇALIŞMA MODU SEÇİMİ" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Button Command="{Binding ToggleAutoModeCommand}" Style="{StaticResource ModernButton}" Background="#334155" Height="36" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Mod: " Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="OTOMATİK" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource AccentCyan}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAutoMode}" Value="False">
                                                <Setter Property="Text" Value="MANUEL"/>
                                                <Setter Property="Foreground" Value="{StaticResource StatusAmber}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- Manuel İtici Tetikleme (Sadece Manuel Modda Aktif) -->
                    <Button Content="Manuel Pistonu İt (Pusher)" Command="{Binding ManualPusherCommand}" Style="{StaticResource ModernButton}" 
                            Background="#D97706" Height="36" FontSize="12" Margin="0,0,0,16"/>

                    <Separator Background="{StaticResource CardBorder}" Margin="0,0,0,14"/>

                    <!-- ACİL STOP (E-STOP) MANTAR BUTON STİLİ -->
                    <TextBlock Text="SAHA EMNİYETİ / ACİL DURUM" Foreground="{StaticResource StatusRed}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Button Command="{Binding ToggleEStopCommand}" Style="{StaticResource ModernButton}" Background="#DC2626" Height="64" Margin="0,0,0,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🛑 ACİL DURDURMA" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="(EMERGENCY STOP - DBX0.3)" FontSize="10" Foreground="#FECACA" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- 4. ALT PANEL: CANLI OT/IT LOG VE ETKİNLİK AKIŞI -->
        <!-- =================================================================== -->
        <Border Grid.Row="3" Style="{StaticResource IndustrialCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="SCADA &amp; PLC CANLI HABERLEŞME LOGLARI" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="OT/IT Protokolü: S7 Protocol (TCP Port 102) | Polling: 100ms" Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Right"/>
                </Grid>

                <ListBox Grid.Row="1" ItemsSource="{Binding ActivityLogs}" Background="#0B132B" BorderBrush="#1C2541" BorderThickness="1" 
                         Foreground="#CBD5E1" FontFamily="Consolas" FontSize="11" Padding="6"/>
            </Grid>
        </Border>
    </Grid>
</Window>
