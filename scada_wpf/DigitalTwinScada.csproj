<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>DigitalTwinScada</RootNamespace>
    <AssemblyName>DigitalTwinScada</AssemblyName>
    <ApplicationTitle>Digital Twin Conveyor SCADA - Siemens S7-1200</ApplicationTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="S7netplus" Version="0.20.0" />
  </ItemGroup>

</Project>
