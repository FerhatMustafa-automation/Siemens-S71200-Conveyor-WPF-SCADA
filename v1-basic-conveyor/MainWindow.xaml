ld" BorderThickness="0" Margin="0,0,0,10"/>                        <!-- RESET COUNTER -->                        <Button Command="{Binding ResetCounterCommand}" Content="­þöä Say¦-c¦-y¦- S¦-f¦-rla (Reset)" Height="36" Background="#334155" Foreground="#94A3B8" FontWeight="SemiBold" BorderThickness="0" Margin="0,0,0,16"/>                        <Separator Background="#334155" Margin="0,0,0,16"/>                        <!-- SIEMENS S7-1200 PLC SETTINGS -->                        <TextBlock Text="SIEMENS S7-1200 HABERLE+ÞME" Foreground="#38BDF8" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>                        <!-- IP Address Input -->                        <TextBlock Text="PLC IP Adresi:" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4"/>                        <TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" Height="36" Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#334155" BorderThickness="1" Padding="10,8" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>                        <!-- Connect / Disconnect Button -->                        <Button Command="{Binding ToggleConnectCommand}" Height="44" BorderThickness="0" Margin="0,0,0,16">                            <Button.Style>                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">                                    <Setter Property="Background" Value="#2563EB"/>                                    <Setter Property="Content" Value="­þöî Siemens PLC'ye Ba¦þlan"/>                                    <Setter Property="Foreground" Value="#FFFFFF"/>                                    <Setter Property="FontWeight" Value="Bold"/>                                    <Style.Triggers>                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">                                            <Setter Property="Background" Value="#475569"/>                                            <Setter Property="Content" Value="ÔØî PLC Ba¦þlant¦-s¦-n¦- Kes"/>                                        </DataTrigger>                                    </Style.Triggers>                                </Style>                            </Button.Style>                        </Button>                        <!-- ASOSEM INFORMATION CARD -->                        <Border Background="#0F172A" CornerRadius="8" Padding="12" BorderBrush="#334155" BorderThickness="1">                            <StackPanel>                                <TextBlock Text="­þÆí ASOSEM Sunum Notu:" Foreground="#F59E0B" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>                                <TextBlock Text="ÔÇó TIA Portal'da CPU Ayarlar¦-nda 'PUT/GET' iznini aktif etmeyi unutmay¦-n.&#10;ÔÇó PLC ba¦þl¦- de¦þilken aray+-z tam sim+-lasyon modunda +ðal¦-+þ¦-r." Foreground="#94A3B8" FontSize="10" TextWrapping="Wrap"/>                            </StackPanel>                        </Border>                    </StackPanel>                </ScrollViewer>            </Border>        </Grid>        <!-- FOOTER STATUS BAR -->        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="12,8" Margin="0,16,0,0">            <Grid>                <Grid.ColumnDefinitions>                    <ColumnDefinition Width="*"/>                    <ColumnDefinition Width="Auto"/>                </Grid.ColumnDefinitions>                <TextBlock Text="ASOSEM Ankara 1. OSB Otomasyon Kursu | TIA Portal S7-1200 Proje Uygulamas¦-" Foreground="#64748B" FontSize="11"/>                <TextBlock Grid.Column="1" Text="KonveyorWpf | .NET WPF &amp; S7NetPlus" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>            </Grid>        </Border>    </Grid></Window>