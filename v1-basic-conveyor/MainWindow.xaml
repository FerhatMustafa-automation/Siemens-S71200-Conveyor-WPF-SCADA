anel>                                </StackPanel>                            </StackPanel>                        </Border>                    </Grid>                </Grid>            </Border>            <!-- RIGHT: CONTROL BUTTONS & PLC CONNECT PANEL -->            <Border Grid.Column="1" Background="#1E293B" CornerRadius="12" Padding="16">                <ScrollViewer VerticalScrollBarVisibility="Auto">                    <StackPanel Orientation="Vertical">                        <!-- CONTROL PANEL TITLE -->                        <TextBlock Text="KONTROL &amp; KUMANDA PANELD¦-R" Foreground="#38BDF8" FontSize="12" FontWeight="Bold" Margin="0,0,0,12"/>                        <!-- START BUTTON (%I0.0) -->                        <Button Command="{Binding StartCommand}" Height="54" Margin="0,0,0,10" BorderThickness="0">                            <Button.Style>                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">                                    <Setter Property="Background" Value="#16A34A"/>                                    <Style.Triggers>                                        <Trigger Property="IsMouseOver" Value="True">                                            <Setter Property="Background" Value="#22C55E"/>                                        </Trigger>                                    </Style.Triggers>                                </Style>                            </Button.Style>                            <StackPanel Orientation="Horizontal">                                <TextBlock Text="ÔûÂ" Foreground="#FFFFFF" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>                                <StackPanel VerticalAlignment="Center">                                    <TextBlock Text="START BUTONU" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"/>                                    <TextBlock Text="Konvey+Âr+- Ba+þlat (%I0.0)" Foreground="#DCFCE7" FontSize="10"/>                 