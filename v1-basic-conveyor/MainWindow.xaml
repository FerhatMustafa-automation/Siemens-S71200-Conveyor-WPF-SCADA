Setter.Value>                    <ControlTemplate TargetType="TextBox">                        <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">                            <ScrollViewer x:Name="PART_ContentHost" Margin="4"/>                        </Border>                    </ControlTemplate>                </Setter.Value>            </Setter>        </Style>    </Window.Resources>    <Grid Margin="16">        <Grid.RowDefinitions>            <!-- Header -->            <RowDefinition Height="Auto"/>            <!-- Main Content Area -->            <RowDefinition Height="*"/>            <!-- Footer Status Bar -->            <RowDefinition Height="Auto"/>        </Grid.RowDefinitions>        <!-- HEADER -->        <Border Grid.Row="0" Background="#1E293B" CornerRadius="12" Padding="16,12" Margin="0,0,0,16">            <Grid>                <Grid.ColumnDefinitions>                    <ColumnDefinition Width="*"/>                    <ColumnDefinition Width="Auto"/>                </Grid.ColumnDefinitions>                <StackPanel Orientation="Vertical">                    <TextBlock Text="ASOSEM OTOMASYON LABORATUVARI" Foreground="#38BDF8" FontSize="12" FontWeight="Bold"/>                    <TextBlock Text="Siemens S7-1200 Konvey+Âr &amp; Piston SCADA Aray+-z+-" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>                </StackPanel>                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">                    <Border Background="#0F172A" CornerRadius="8" Padding="12,6" Margin="0,0,10,0">                        <StackPanel Orientation="Horizontal">                            <Ellipse Width="10" Height="10" Margin="0,0,8,0">                                <Ellipse.Style>                                    <Style TargetType="Ellipse">                                        <Setter Property="Fill" Value="#EF4444"/>                                        <Style.Triggers>                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">                                                <Setter Property="Fill" Value="#22C55E"/>                                            </DataTrigger>                                        </Style.Triggers>                                    </Style>                                </Ellipse.Style>                            </Ellipse>                            <TextBlock Text="{Binding StatusMessage}" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>                        </StackPanel>                    </Border>                </StackPanel>            </Grid>        </Border>        <!-- MAIN SCADA + CONTROL PANELS -->        <Grid Grid.Row="1">            <Grid.ColumnDefinitions>                <!-- Left: Interactive Visual SCADA Canvas -->                <ColumnDefinition Width="2*"/>                <!-- Right: Control & Diagnostics Panel -->                <ColumnDefinition Width="*"/>            </Grid.ColumnDefinitions>            <!-- LEFT: CONVEYOR & PISTON ANIMATION VIEWPORT -->            <Border Grid.Column="0" Background="#1E293B" CornerRadius="12" Padding="16" Margin="0,0,12,0" ClipToBounds="True">                <Grid>                    <Grid.RowDefinitions>                        <RowDefinition Height="Auto"/>                        <RowDefinition Height="*"/>                        <RowDefinition Height="Auto"/>                    </Grid.RowDefinitions>                    <TextBlock Grid.Row="0" Text="CANLI SAHA AN¦-MASYONU VE SENS+ûR G+ûR+£NT+£LEME" Foreground="#94A3B8" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>                    <!-- CANVAS ANIMATION AREA -->                    <Canvas Grid.Row="1" Background="#0F172A" x:Name="ScadaCanvas" Margin="0,10">                        <!-- Grid Lines Effect -->                        <Rectangle Width="660" Height="380" Fill="#0F172A" Stroke="#1E293B" StrokeThickness="1"/>                        <!-- CONVEYOR BELT BODY -->                        <Border Canvas.Left="40" Canvas.Top="220" Width="580" Height="44" Background="#334155" CornerRadius="6" BorderBrush="#475569" BorderThickness="2">                            <!-- Conveyor Rollers -->                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">                                <Ellipse Width="24" Height="24" Fill="#64748B" Margin="10,0"/>                                <Ellipse Width="24" Height="24" Fill="#64748B" Margin="10,0"/>                                <Ellipse Width="24" Height="24" Fill="#64748B" Margin="10,0"/>                                <Ellipse Width="24" Height="24" Fill="#64748B" Margin="10,0"/>                                <Ellipse Width="24" Height="24" Fill="#64748B" Margin="10,0"/>                                <Ellipse Width="24" Height="24" Fill="#64748B" Margin="10,0"/>                                <Ellipse Width="24" Height="24" Fill="#64748B" Margin="10,0"/>                                <Ellipse Width="24" Height="24" Fill="#64748B" Margin="10,0"/>                            </StackPanel>                        </Border>                        <!-- PNEUMATIC PISTON CYLINDER (%Q0.1) -->                        <Canvas Canvas.Left="310" Canvas.Top="60">                            <!-- Cylinder Base Housing -->                            <Rectangle Width="54" Height="85" Fill="#475569" RadiusX="6" RadiusY="6" Stroke="#64748B" StrokeThickness="2"/>                            <!-- Cylinder Label -->                            <TextBlock Text="PISTON&#10;(%Q0.1)" Foreground="#F8FAFC" FontSize="9" FontWeight="Bold" Canvas.Left="6" Canvas.Top="32" TextAlignment="Center"/>                                                        <!-- Piston Extension Arm / Rod (Y Position bound to PistonRodY & Animated) -->                     